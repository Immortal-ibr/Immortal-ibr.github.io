---
import { CATEGORY_ORDER } from '../consts';
import { getPosts, blogPosts, countBy, url, slugify } from '../utils';

interface Props {
  active?: string;
}
const { active } = Astro.props;

// Section categories (Research, Tools) are reached from the nav, not from here,
// so they're excluded — which also keeps the "All" count honest.
const posts = blogPosts(await getPosts());
const counts = countBy(posts, 'category');
const cats = [...counts.entries()].sort((a, b) => {
  const ia = CATEGORY_ORDER.indexOf(a[0]);
  const ib = CATEGORY_ORDER.indexOf(b[0]);
  if (ia !== -1 && ib !== -1) return ia - ib;
  if (ia !== -1) return -1;
  if (ib !== -1) return 1;
  return a[0].localeCompare(b[0]);
});
---

<nav class="filters" aria-label="Filter by category">
  <a class="chip" href={url('blog/')} aria-current={active ? undefined : 'page'}>
    All <i>{posts.length}</i>
  </a>
  {cats.map(([name, count]) => (
    <a
      class="chip"
      href={url(`category/${slugify(name)}/`)}
      aria-current={active === name ? 'page' : undefined}
    >
      {name} <i>{count}</i>
    </a>
  ))}
</nav>
