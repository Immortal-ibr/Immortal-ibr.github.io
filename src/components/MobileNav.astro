---
import { NAV_LINKS } from '../consts';
import { url } from '../utils';

interface Props {
  activeHref?: string;
}

const { activeHref } = Astro.props;
---

<details class="mobile-nav">
  <summary aria-label="Navigation menu" title="Navigation menu">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </summary>
  <div class="mobile-nav-panel">
    {NAV_LINKS.map((link) => (
      <a href={url(link.href)} aria-current={link.href === activeHref ? 'page' : undefined}>{link.label}</a>
    ))}
  </div>
</details>
