---
// Browse every tag in one place. The per-tag pages at /tag/<slug>/ already
// existed, but nothing linked to them — this is the way in.
import Base from '../../layouts/Base.astro';
import { getPosts, tagCounts, slugify, url } from '../../utils';

const posts = await getPosts();
// Busiest tags first, then alphabetically so the order is stable.
const tags = [...tagCounts(posts).entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
---

<Base title="Tags" description="Browse posts by topic.">
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">{tags.length} {tags.length === 1 ? 'tag' : 'tags'}</p>
      <h1>Tags</h1>
      <p class="blurb">Every topic on the blog, busiest first.</p>
    </div>

    {tags.length === 0 ? (
      <p>No tags yet.</p>
    ) : (
      <ul class="tag-cloud">
        {tags.map(([tag, count]) => (
          <li>
            <a href={url(`tag/${slugify(tag)}/`)}>
              <span class="t">#{tag}</span><i>{count}</i>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</Base>
