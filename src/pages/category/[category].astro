---
import Base from '../../layouts/Base.astro';
import Filters from '../../components/Filters.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, pinnedFirst, slugify, isSectionCategory } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const names = [...new Set(posts.map((p) => (p.data.category ?? '').trim()).filter(Boolean))];
  return names.map((name) => ({
    params: { category: slugify(name) },
    props: { name, posts: pinnedFirst(posts.filter((p) => (p.data.category ?? '').trim() === name)) },
  }));
}

const { name, posts } = Astro.props;
// Research and Tools stand on their own in the nav. The filter row only lists
// blog categories, so on those pages it would show a row with nothing active
// in it — drop it and let the nav carry the "you are here".
const standalone = isSectionCategory(name);
---

<Base title={name} description={`Posts in the ${name} category.`}>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      <h1>{name}</h1>
    </div>
    {!standalone && <Filters active={name} />}
    <PostList posts={posts} />
  </div>
</Base>
