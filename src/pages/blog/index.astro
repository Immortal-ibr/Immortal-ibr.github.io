---
import Base from '../../layouts/Base.astro';
import Filters from '../../components/Filters.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, blogPosts, pinnedFirst } from '../../utils';

// Research and Tools have their own nav sections, so they're not repeated here.
const posts = blogPosts(await getPosts());
// The featured (big) slot: a pinned post wins; otherwise the newest takes it,
// but only when the grid still comes out even behind it — see shouldFeature.
const ordered = pinnedFirst(posts);
---

<Base title="Blog" description="CTF writeups, notes and journal entries." navHref="blog/">
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      <h1>Blog</h1>
    </div>
    <Filters />
    {posts.length === 0 ? <p>No posts yet — check back soon.</p> : <PostList posts={ordered} />}
  </div>
</Base>
