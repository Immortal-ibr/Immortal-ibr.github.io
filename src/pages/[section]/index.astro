---
// Top-level pages for the categories promoted into the nav — /research/,
// /tools/. Driven by SECTION_CATEGORIES so adding a section is a one-line
// change in consts.ts, not a new file.
//
// Astro resolves static routes ahead of dynamic ones, so /blog/, /about/ and
// /tags/ keep their own files; getStaticPaths below only ever emits the
// section slugs, so nothing else can fall through to here.
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { SECTION_CATEGORIES, AUTHOR } from '../../consts';
import { getPosts, pinnedFirst, slugify } from '../../utils';

export async function getStaticPaths() {
  // These posts share a publication date, so give their Research cards a stable
  // reading order without changing the date order of other posts.
  const ramSeriesOrder = new Map<string, number>([
    ['chatgpt-windows-ram-case-study', 1],
    ['chatgpt-browser-state-changes', 2],
    ['codex-cli-windows-ram', 3],
  ]);
  const posts = await getPosts();
  return SECTION_CATEGORIES.map((name) => {
    const sectionPosts = posts.filter((p) => (p.data.category ?? '').trim() === name);
    if (name === 'Research') {
      sectionPosts.sort((a, b) => {
        const dateOrder = b.data.published.valueOf() - a.data.published.valueOf();
        if (dateOrder !== 0) return dateOrder;
        return (ramSeriesOrder.get(a.id) ?? Number.MAX_SAFE_INTEGER)
          - (ramSeriesOrder.get(b.id) ?? Number.MAX_SAFE_INTEGER);
      });
    }
    return {
      params: { section: slugify(name) },
      props: { name, posts: pinnedFirst(sectionPosts) },
    };
  });
}

const { name, posts } = Astro.props;
---

<Base
  title={name}
  description={`${name} posts by ${AUTHOR}.`}
  navHref={`${slugify(name)}/`}
>
  <div class="wrap">
    <div class="page-head">
      <p class="eyebrow">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
      <h1>{name}</h1>
    </div>
    {posts.length === 0 ? (
      <p>Nothing here yet — check back soon.</p>
    ) : (
      <PostList posts={posts} />
    )}
  </div>
</Base>
